# Copy this file to a user-specific path and pass it to the Azure VM scripts.
# Fill in the top section first. Those values define the Azure subscription,
# VM identity, SSH access, hostname, and app image the scripts will use.
# The lower sections are the app/runtime secrets and can usually be copied from
# your existing local or Container Apps deployment config.

# =============================================================================
# Azure resource choices
# =============================================================================

# Azure subscription to target.
AZURE_SUBSCRIPTION=
# Resource group that will contain the VM and its network resources.
AZURE_RESOURCE_GROUP=hep-data-web-vm
# Azure region for the VM and managed disk.
AZURE_LOCATION=eastus
# Name of the Linux VM to create.
AZURE_VM_NAME=hep-data-web-vm
# VM size. Start with Standard_B2s unless you know you need more memory.
AZURE_VM_SIZE=Standard_B2s
# Admin username created on the VM.
AZURE_VM_ADMIN_USER=hepadmin
# Path to your local SSH public key used for VM login.
AZURE_VM_SSH_PUBLIC_KEY_PATH=
# Managed disk name that will hold persistent VM data.
AZURE_VM_DATA_DISK_NAME=hep-data-web-vm-data
# Managed disk size in GiB.
AZURE_VM_DATA_DISK_SIZE_GB=128
# Optional Azure DNS label for the VM public IP.
AZURE_VM_DNS_LABEL=hep-data-llm
# Public hostname that users will browse. Leave blank for an initial HTTP-only
# deployment on the Azure public IP, then fill it in later if you add TLS.
AZURE_VM_PUBLIC_HOSTNAME=
# Published app image to pull on the VM.
AZURE_VM_IMAGE=ghcr.io/<owner>/<image>:latest
# Optional source CIDR for SSH restriction, for example your office or home IP.
AZURE_VM_ALLOWED_SSH_CIDR=
# Mount point for the persistent data disk inside the VM.
AZURE_VM_DATA_MOUNT=/srv/hep-data-web
# Email address used by Caddy/Let's Encrypt for certificate notices.
# Leave blank until you switch to AZURE_VM_TLS_MODE=letsencrypt.
AZURE_VM_TLS_EMAIL=
# TLS mode. Use http for a first-pass deployment without a hostname.
AZURE_VM_TLS_MODE=http
# Manual cert path, only used if you switch away from Let's Encrypt.
AZURE_VM_TLS_CERT_PATH=
# Manual key path, only used if you switch away from Let's Encrypt.
AZURE_VM_TLS_KEY_PATH=

# =============================================================================
# Application secrets and runtime configuration
# =============================================================================

# Django secret key for production.
SECRET_KEY=
# Hostnames the app should accept.
ALLOWED_HOSTS=
# Browser-origin list for CSRF protection.
CSRF_TRUSTED_ORIGINS=
# Production database URL used by Django.
DATABASE_URL=postgresql://hep_data_web:hep_data_web@postgres:5432/hep_data_web
# GitHub OAuth client id.
GITHUB_CLIENT_ID=
# GitHub OAuth client secret.
GITHUB_CLIENT_SECRET=
# Optional GitHub org restriction.
GITHUB_ORG=
# GitHub usernames that should be treated as admins.
GITHUB_ADMIN_USERS=
# Admin email addresses for approval notifications.
ADMIN_EMAILS=
# OpenAI API key used by backend jobs.
OPENAI_API_KEY=
# Path to your local ServiceX YAML file on the machine running deployment.
# The deploy script copies it to the VM home directory. Inside the VM
# containers, the file is mounted at `/host-home/servicex.yaml` and the backend
# copies it into the job workspace before launching `hep-data-llm plot`.
SERVICEX_CONFIG_PATH=
# Backend home directory inside the VM/containers.
HEP_DATA_LLM_HOME_DIR=/host-home
# Backend image override for ServiceX + Awkward.
HEP_DATA_LLM_SERVICEX_AWKWARD_DOCKER_IMAGE=
# Backend image override for RDF.
HEP_DATA_LLM_RDF_DOCKER_IMAGE=
# Default backend model name.
HEP_DATA_LLM_MODEL=gpt-54-mini
# Number of repair cycles allowed for backend jobs.
HEP_DATA_LLM_REPAIR_CYCLES=10
# Queue limit for the low-traffic VM deployment. Keep this small.
JOB_QUEUE_LIMIT=3
# Worker poll interval in seconds.
JOB_POLL_INTERVAL_SECONDS=1
# Soft timeout in seconds for backend jobs.
JOB_SOFT_TIMEOUT_SECONDS=1800
# Hard timeout in seconds for backend jobs.
JOB_HARD_TIMEOUT_SECONDS=2400
# Email backend used by the production deployment.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# SMTP host.
EMAIL_HOST=
# SMTP port.
EMAIL_PORT=587
# SMTP username.
EMAIL_HOST_USER=
# SMTP password.
EMAIL_HOST_PASSWORD=
# Whether SMTP should use TLS.
EMAIL_USE_TLS=true
# Whether SMTP should use SSL.
EMAIL_USE_SSL=false
# Default from address for outbound mail.
DEFAULT_FROM_EMAIL=hep-data-web@example.org
# PostgreSQL password used by the local Compose stack on the VM.
POSTGRES_PASSWORD=hep_data_web

# Optional backup targets.
# Azure Storage account name for backup uploads.
AZURE_BACKUP_STORAGE_ACCOUNT=
# Blob container name for backup uploads.
AZURE_BACKUP_CONTAINER=
# Resource group that owns the backup storage, if separate.
AZURE_BACKUP_RESOURCE_GROUP=
# Connection string used to upload backups, if you choose Blob Storage.
AZURE_BACKUP_CONNECTION_STRING=
