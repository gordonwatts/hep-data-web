# Copy this file to a user-specific path and pass that path to the Azure scripts.
# The create and delete scripts load the example defaults first, then the user file.

# =============================================================================
# Public-facing deployment choices
# =============================================================================

# Azure subscription to target when creating or deleting resources.
AZURE_SUBSCRIPTION=

# Azure resource group that will hold the deployment.
AZURE_RESOURCE_GROUP=hep-data-web-prod

# Azure region where the app, storage, and database will live.
AZURE_LOCATION=eastus

# Shared prefix used when deriving resource and app names.
AZURE_APP_NAME_PREFIX=hep-data-web

# Azure Container Registry name that will hold the application image.
AZURE_CONTAINER_REGISTRY_NAME=hepdatawebacr

# Docker image name used inside Azure Container Registry.
AZURE_IMAGE_NAME=hep-data-web

# Image tag to import into Azure Container Registry and deploy from.
AZURE_IMAGE_TAG=latest

# Hostnames the Django app should accept.
AZURE_ALLOWED_HOSTS=*

# Optional HTTPS origins allowed for browser requests.
AZURE_CSRF_TRUSTED_ORIGINS=

# PFX certificate file used for custom hostname binding.
AZURE_CERTIFICATE_PATH=

# =============================================================================
# Secrets and external-system credentials
# =============================================================================

# PostgreSQL admin password used to create the Azure database server.
AZURE_POSTGRES_ADMIN_PASSWORD=

# Django SECRET_KEY for the web application.
AZURE_DJANGO_SECRET_KEY=

# GitHub OAuth client secret for login integration.
AZURE_GITHUB_CLIENT_SECRET=

# GitHub OAuth client ID for login integration.
GITHUB_CLIENT_ID=

# Optional GitHub organization used to scope login or admin access.
GITHUB_ORG=

# Comma-separated GitHub usernames that should be treated as admin users.
GITHUB_ADMIN_USERS=

# Comma-separated admin email addresses for approval notifications.
ADMIN_EMAILS=

# Docker Hub image copied into Azure Container Registry.
DOCKER_HUB_SOURCE_IMAGE=docker.io/<namespace>/<image>:<tag>

# Docker Hub username used only when the source image is private.
DOCKER_HUB_USERNAME=

# Docker Hub token or password used only when the source image is private.
DOCKER_HUB_PASSWORD=

# Password for the optional certificate PFX file.
AZURE_CERTIFICATE_PASSWORD=

# Path to a local ServiceX YAML file; its contents are loaded into Azure as a secret volume.
SERVICEX_CONFIG_PATH=

# OpenAI API key source value; the script maps this into api_openai_com_API_KEY in the container.
OPENAI_API_KEY=

# =============================================================================
# Azure internal names and runtime defaults
# =============================================================================

# Container Apps environment name; the script can derive this if you leave it blank.
AZURE_CONTAINER_APPS_ENVIRONMENT_NAME=hep-data-web-env

# Container Apps log destination; use none for the cheapest setup, or log-analytics if you want environment logs.
AZURE_CONTAINER_APPS_LOGS_DESTINATION=none

# Log Analytics workspace ID used only when AZURE_CONTAINER_APPS_LOGS_DESTINATION=log-analytics.
AZURE_CONTAINER_APPS_LOGS_WORKSPACE_ID=

# Log Analytics workspace key used only when AZURE_CONTAINER_APPS_LOGS_DESTINATION=log-analytics.
AZURE_CONTAINER_APPS_LOGS_WORKSPACE_KEY=

# Web app name inside Azure Container Apps.
AZURE_WEB_APP_NAME=hep-data-web-web

# Worker app name inside Azure Container Apps.
AZURE_WORKER_APP_NAME=hep-data-web-worker

# Storage account used for persistent media and artifacts.
AZURE_STORAGE_ACCOUNT_NAME=hepdatawebstorage

# Azure File share mounted into the app containers.
AZURE_STORAGE_SHARE_NAME=media

# PostgreSQL server name in Azure Database for PostgreSQL flexible server.
AZURE_POSTGRES_SERVER_NAME=hep-data-web-pg

# PostgreSQL database name created on the server.
AZURE_POSTGRES_DATABASE_NAME=hep_data_web

# PostgreSQL admin username for the managed server.
AZURE_POSTGRES_ADMIN_USER=hepadmin

# Whether secret values are read from the config file or prompted interactively.
AZURE_SECRETS_SOURCE=Environment

# ServiceX + Awkward backend image override for the worker runtime.
HEP_DATA_LLM_SERVICEX_AWKWARD_DOCKER_IMAGE=

# RDF backend image override for the worker runtime.
HEP_DATA_LLM_RDF_DOCKER_IMAGE=

# Legacy global backend image fallback for the worker runtime.
HEP_DATA_LLM_DOCKER_IMAGE_GLOBAL_FALLBACK=

# Directory that will contain the mounted ServiceX config file inside the container.
HEP_DATA_LLM_HOME_DIR=/home/site

# Default backend profile name used by the app.
HEP_DATA_LLM_MODEL=gpt-54-mini

# Number of repair cycles allowed for backend jobs.
HEP_DATA_LLM_REPAIR_CYCLES=10

# Maximum number of queued jobs allowed at once.
JOB_QUEUE_LIMIT=20

# Seconds between worker polls for new jobs.
JOB_POLL_INTERVAL_SECONDS=1

# Soft timeout in seconds for a backend job.
JOB_SOFT_TIMEOUT_SECONDS=1800

# Hard timeout in seconds for a backend job.
JOB_HARD_TIMEOUT_SECONDS=2400
