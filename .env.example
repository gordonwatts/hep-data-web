DEBUG=1
SECRET_KEY=change-me
DJANGO_SETTINGS_MODULE=hep_data_web.settings.dev
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://hep_data_web:hep_data_web@postgres:5432/hep_data_web
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=hep-data-web@example.org
ADMIN_EMAILS=admin@example.org
STATIC_ROOT=/app/staticfiles
MEDIA_ROOT=/app/media
ARTIFACT_ROOT=/app/media/artifacts
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ORG=
GITHUB_ADMIN_USERS=
HEP_DATA_LLM_VERSION=
# Optional override for Docker Compose or other non-default home mounts.
HEP_DATA_LLM_HOME_DIR=
HEP_DATA_LLM_MODEL=gpt-54-mini
HEP_DATA_LLM_REPAIR_CYCLES=10
HEP_DATA_LLM_SERVICEX_AWKWARD_DOCKER_IMAGE=hepdatallm-awkward:latest
HEP_DATA_LLM_RDF_DOCKER_IMAGE=
HEP_DATA_LLM_DOCKER_IMAGE_GLOBAL_FALLBACK=
# Legacy global fallback kept for compatibility only.
HEP_DATA_LLM_DOCKER_IMAGE=
HEP_DATA_LLM_EXAMPLE_PACKAGE=
HEP_DATA_LLM_DEFAULT_DATASET=
JOB_QUEUE_LIMIT=20
JOB_POLL_INTERVAL_SECONDS=1
JOB_SOFT_TIMEOUT_SECONDS=1800
JOB_HARD_TIMEOUT_SECONDS=2400
