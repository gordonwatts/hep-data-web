GITHUB_ORG=
GITHUB_ADMIN_USERS=
HEP_DATA_LLM_VERSION=
JOB_QUEUE_LIMIT=20
JOB_POLL_INTERVAL_SECONDS=2
JOB_SOFT_TIMEOUT_SECONDS=1800
